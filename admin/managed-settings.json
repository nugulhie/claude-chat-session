{
  "channelsEnabled": true,
  "allowedChannelPlugins": [
    {
      "marketplace": "claude-peers",
      "plugin": "peers"
    }
  ],
  "extraKnownMarketplaces": {
    "claude-peers": {
      "source": {
        "source": "github",
        "repo": "nugulhie/claude-chat-session"
      }
    }
  },
  "enabledPlugins": {
    "peers@claude-peers": true
  },
  "pluginConfigs": {
    "peers@claude-peers": {
      "options": {
        "broker_url": "https://peers.example.com"
      }
    }
  },
  "permissions": {
    "allow": [
      "mcp__plugin_peers_peers__list_peers",
      "mcp__plugin_peers_peers__check_inbox",
      "mcp__plugin_peers_peers__set_status"
    ]
  }
}
