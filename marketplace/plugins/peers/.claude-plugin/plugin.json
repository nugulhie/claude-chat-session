{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "peers",
  "displayName": "Claude Peers",
  "version": "0.2.0",
  "description": "사내 동료 개발자의 Claude Code 세션에 질문을 푸쉬하고 답을 받는 채널",
  "author": {
    "name": "nugulhie",
    "url": "https://github.com/nugulhie"
  },
  "userConfig": {
    "broker_url": {
      "type": "string",
      "title": "Broker URL",
      "description": "peers 브로커 주소. https 를 쓰세요 (예: https://peers.example.com). http 로 두면 개인 토큰과 질문/답변 본문이 평문으로 전송됩니다 — 로컬 시험용으로만 쓰세요.",
      "required": true
    },
    "token": {
      "type": "string",
      "title": "Peers token",
      "description": "플랫폼팀에서 발급받은 개인 토큰 (pk_로 시작)",
      "sensitive": true,
      "required": true
    },
    "default_room": {
      "type": "string",
      "title": "기본 방",
      "description": "세션이 기본으로 들어갈 방. PEERS_ROOM 환경변수가 있으면 그것이 우선합니다. 비우면 public.",
      "required": false
    }
  },
  "mcpServers": {
    "peers": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/server.py"
      ],
      "env": {
        "PEERS_BROKER_URL": "${user_config.broker_url}",
        "PEERS_TOKEN": "${user_config.token}",
        "PEERS_LISTEN": "${PEERS_LISTEN:-0}",
        "PEERS_DEFAULT_ROOM": "${user_config.default_room}",
        "PEERS_ROOM": "${PEERS_ROOM:-}",
        "PEERS_ROOM_SUBJECT": "${PEERS_ROOM_SUBJECT:-}"
      }
    }
  },
  "channels": [
    {
      "server": "peers"
    }
  ],
  "homepage": "https://github.com/nugulhie/claude-chat-session"
}
